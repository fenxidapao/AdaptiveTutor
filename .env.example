# ===== Ollama 模型（按需改）=====
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# ===== RAG 调参 =====
CHUNK_SIZE=800
CHUNK_OVERLAP=150
LLM_TEMPERATURE=0.2

# ===== 重排 Reranker =====
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# reranker 权重加载需访问 HuggingFace；本机 huggingface.co 不可达会超时卡死，
# 默认走镜像（config.py 已设默认，这里可显式覆盖）。
HF_ENDPOINT=https://hf-mirror.com
RETRIEVE_K=50
RERANKER_TOP_N=5

# ===== 路径 =====
DATA_DIR=./data
PERSIST_DIRECTORY=./chroma_db
