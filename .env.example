# ===== Ollama 模型 =====
EMBEDDING_MODEL=nomic-embed-text
# 生成模型：provider=ollama 时填 Ollama 模型名；provider=openai 时填云端模型名
LLM_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.2

# ===== 生成 provider（C3 去本地化，2026-10-15）=====
# ollama = 本地生成（默认，行为与旧版一致）
# openai = OpenAI 兼容云端生成（走 LLM_API_BASE）
# 背景：本地生成 4.9GB + 本地裁判 4.7GB > 本机 8GB 显存，Windows WDDM 不报 OOM
# 而是让 CUDA 调用挂住（详见 04_踩坑与纪律.md 纪律 28）。
LLM_PROVIDER=ollama
# 云端 OpenAI 兼容接口（仅 LLM_PROVIDER=openai 时使用）
LLM_API_BASE=https://kuaipao.pro/v1
# 云端 key：留空时自动尝试环境变量 LLM_API_KEY / KUAIPAO_API_KEY，
# 再尝试 ~/.dsh/.credentials.yaml 的 KUAIPAO_API_KEY；**不要把真实 key 写进仓库**。
# LLM_API_KEY=sk-xxxx
# 推理模型预算：deepseek-v4.1-flash 实测 max_tokens=256 时全部耗在 reasoning、
# content 为空；故默认 2048，并在空 content+reasoning 占满时自动翻倍到 cap。
LLM_TIMEOUT=180
LLM_MAX_TOKENS=2048
LLM_MAX_TOKENS_CAP=8192

# ===== 切分 / 路径 =====
# 注意：与 config 默认及实际评估基线一致（CHUNK_SIZE=800 / CHUNK_OVERLAP=150，
# 全部 A/B 与 held-out 数字在此配置下测得；勿改回 500/80 以免与评估证据脱节）
CHUNK_SIZE=800
CHUNK_OVERLAP=150
DATA_DIR=./data
PERSIST_DIRECTORY=./chroma_db

# 均字符/页低于此阈值视为无文字层（扫描版），建库时告警跳过而非静默空索引
PDF_MIN_CHARS_PER_PAGE=30

# ===== 混合检索（向量 + BM25 + RRF）=====
HYBRID_ENABLED=true
# 向量通道独立召回数（难 query 正确块常排 30+，池不够捞不到）
RETRIEVE_K=50
# BM25 通道独立召回数（对全库打分，不复用向量候选池）
BM25_TOP_K=50
# RRF 融合后的候选池大小，供精排消费
RERANK_CANDIDATE_K=16

# ===== 重排 Reranker =====
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 精排后进 LLM 的块数。官方评估基线为 top-8 口径，勿随意下调
RERANKER_TOP_N=8
# 枚举类问题的进 LLM 块数（常规走 RERANKER_TOP_N）
ENUM_RERANK_TOP_N=14
# reranker 与模型权重加载需访问 HuggingFace；本机 huggingface.co 不可达会超时卡死，
# 默认走镜像（config.py 已设默认，这里可显式覆盖）
HF_ENDPOINT=https://hf-mirror.com

# ===== 拒答 / 接地自检 =====
# 向量分低于此值判为语料外 → 硬拒答
HARD_REJECT_VECTOR_THRESHOLD=0.55
# 精排分低于此值判为语料外 → 硬拒答
HARD_REJECT_RERANK_THRESHOLD=0.30
# 接地自检阈值；未达标记 low_confidence
GROUNDED_SCORE_THRESHOLD=0.60

# ===== Query 改写（多轮指代消解）=====
QUERY_REWRITE_ENABLED=true

# ===== 语义缓存 =====
SEMANTIC_CACHE_ENABLED=true
# 命中阈值（embedding 余弦）
SEMANTIC_CACHE_SIM=0.93
# 内存 LRU 容量；多副本部署需换 Redis
SEMANTIC_CACHE_MAX=128

# ===== 评估裁判 =====
# local=Ollama 本地独立模型（默认 qwen2.5:7b，需先 ollama pull qwen2.5:7b，数据不出本机；
# 2026-08-22 3b vs 7b 十题实测后定稿 7b）
# deepseek=DeepSeek API（效果更强，但数据出本机；需设置 JUDGE_API_KEY）
JUDGE_PROVIDER=local
JUDGE_MODEL=qwen2.5:7b
# JUDGE_API_KEY=sk-xxxx

# ===== API 服务（FastAPI）=====
# uvicorn 监听端口：由启动命令的 --port 决定，config.py 不读取本变量（设了也不生效）
# 本地启动：uvicorn main:app --host 0.0.0.0 --port 8000
# 注：本项目走本地 Ollama（数据不出本机），没有云端 API 密钥。
# Docker 部署时在 docker-compose.yml 里把 OLLAMA_BASE_URL 指到宿主（host.docker.internal:11434）

# ===== 多用户预留扩展点（默认关闭，需公网暴露时再开）=====
# 开启后所有端点需请求头 X-API-Key: <API_KEY>
AUTH_ENABLED=false
API_KEY=
# 每 IP 每分钟请求上限，0=不限
RATE_LIMIT=0
# 生产环境收紧跨域，填具体域名
CORS_ORIGINS=*
# /documents 上传大小上限（MB），超限返回 413
MAX_UPLOAD_MB=100
