# ===== Ollama 模型（按需改）=====
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# ===== RAG 调参 =====
# 注意：与 config 默认及实际评估基线一致（CHUNK_SIZE=800 / CHUNK_OVERLAP=150，
# v2 A/B 等全部数字在此配置下测得；勿改回 500/80 以免与评估证据脱节）
CHUNK_SIZE=800
CHUNK_OVERLAP=150
LLM_TEMPERATURE=0.2

# ===== 重排 Reranker =====
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# reranker 权重加载需访问 HuggingFace；本机 huggingface.co 不可达会超时卡死，
# 默认走镜像（config.py 已设默认，这里可显式覆盖）。
HF_ENDPOINT=https://hf-mirror.com
RETRIEVE_K=50
RERANKER_TOP_N=5

# ===== 路径 =====
DATA_DIR=./data
PERSIST_DIRECTORY=./chroma_db

# ===== 加载（T6: 扫描版 PDF 检测）=====
# 均字符/页 低于此阈值视为无文字层（扫描版），建库时告警跳过而非静默空索引
PDF_MIN_CHARS_PER_PAGE=30

# ===== 评估裁判（T2: 独立裁判）=====
# local=Ollama 本地独立模型（默认 qwen2.5:7b，需先 ollama pull qwen2.5:7b，数据不出本机；
# 2026-08-22 3b vs 7b 十题实测后定稿 7b）
# deepseek=DeepSeek API（效果更强，但数据出本机；需设置 JUDGE_API_KEY）
JUDGE_PROVIDER=local
JUDGE_MODEL=qwen2.5:7b
# JUDGE_API_KEY=sk-xxxx

# ===== API 服务（FastAPI，2026-08-20 新增）=====
# uvicorn 监听端口（本地启动：uvicorn main:app --host 0.0.0.0 --port %API_PORT%）
API_PORT=8000
# 注：本项目走本地 Ollama（数据不出本机），没有云端 API 密钥。
# Docker 部署时在 docker-compose.yml 里把 OLLAMA_BASE_URL 指到 ollama 服务即可。
