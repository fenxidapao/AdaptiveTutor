# FeynmanTutor 环境变量模板
# 用法: cp .env.example .env 然后填入真实值
# 本文件列出 config.py 读取的全部环境变量；注释行里是未设置时的默认值。

# ---------- LLM（DeepSeek API 主力） ----------
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ---------- Ollama 降级（仅断网/欠费兜底，费曼追问环节强制禁用） ----------
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b

# ---------- CourseRAG（知识底座，HTTP 调用；未启动则 notes 兜底） ----------
# RAG_BASE_URL=http://127.0.0.1:8000
# RAG_MODE=accurate        # accurate=向量+BM25(reranker)，带相关度分数（推荐）；fast=纯向量，无分数
# RAG_RETRIEVE_TOP_N=8     # 客户端接收上限（实际条数以 CourseRAG 的 RERANKER_TOP_N 为准）
# RAG_DOC_CHAR_LIMIT=1200  # 喂给 LLM 相关性过滤的单条文档截断预算（字符）

# ---------- 状态库 ----------
# DB_PATH=state.db        # Docker 部署时指向挂载卷 /app/data/state.db

# ---------- 沙箱 ----------
# SANDBOX_TIMEOUT=5        # 秒
# SANDBOX_MAX_OUTPUT=65536 # 字节

# ---------- C 阶段实验（EXPERIMENT_AUTH=1 时：强制 session 鉴权 + mode 按分组强制 + 配额生效） ----------
# EXPERIMENT_AUTH=0                # 0=兼容本机演示/既有测试；对外部署收数时置 1
# DAILY_LLM_LIMIT_PER_USER=50      # 每用户每日 LLM 调用上限
# GLOBAL_DAILY_LLM_LIMIT=300       # 全站每日 LLM 调用总量上限（全局熔断）

# ---------- E 阶段 Loop 工程化 ----------
# REFLOW_THRESHOLD=0.6             # 后测低于此阈值且提升不足 → 触发学习回流
# REFLOW_MIN_GAIN=0.3              # 提升不足的定义：后测 − 前测 < 此值
# REFLOW_PASS_SCORE=0.8            # 回流后重测达标线
# REFLOW_MAX_ROUNDS=2              # 回流上限轮数
# DAILY_QUEUE_LIMIT=5              # 每日学习队列上限（知识点数）

# ---------- ②Context 长对话压缩 ----------
# CONTEXT_COMPRESS_AFTER=8         # transcript 超过该条数触发压缩
# CONTEXT_RAW_TAIL=4               # 压缩时保留原文的最近消息条数

# ---------- F 阶段 安全（五层纵深防御） ----------
# ADMIN_USER_IDS=u0                # L3 管理面（审计查看/用户列表等）允许的 user_id，逗号分隔
# IDEMPOTENCY_TTL_SECONDS=3600     # L2 request_id 幂等键保留时长（秒）
# TRANSCRIPT_MAX_MSGS=40           # L1 客户端 transcript 条数上限
# TRANSCRIPT_MSG_CHARS=2000        # L1 单条 transcript 字符上限
